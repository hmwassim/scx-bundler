#!/bin/sh
set -e

[ "$1" = configure ] && [ -d /run/systemd/system ] || exit 0

systemctl daemon-reload || true
if [ -z "$2" ]; then
    # Fresh install: run the default scheduler directly, unless scx-tools is
    # being installed too, in which case scx_loader.service takes over.
    if ! dpkg-query -W -f '${db:Status-Want}' scx-tools 2>/dev/null | grep -q install; then
        systemctl enable --now scx.service || true
    fi
else
    systemctl try-restart scx.service || true
fi
